{
  "indexes": [
    {
      "//": "今週のヒーロー（学年別）: 今週プレイした人だけを weeklyXp の高い順に取得する",
      "collectionGroup": "users",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "grade", "order": "ASCENDING" },
        { "fieldPath": "lastWeekString", "order": "ASCENDING" },
        { "fieldPath": "weeklyXp", "order": "DESCENDING" }
      ]
    },
    {
      "//": "今月のダメージ TOP5（全学年）: 今月プレイした人だけを monthlyDamage の高い順に取得する",
      "collectionGroup": "users",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "lastMonthString", "order": "ASCENDING" },
        { "fieldPath": "monthlyDamage", "order": "DESCENDING" }
      ]
    },
    {
      "//": "先週のヒーロー（学年別・確定済み）: 期間切替時に退避した prevWeeklyXp の高い順に取得する",
      "collectionGroup": "users",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "grade", "order": "ASCENDING" },
        { "fieldPath": "prevWeekString", "order": "ASCENDING" },
        { "fieldPath": "prevWeeklyXp", "order": "DESCENDING" }
      ]
    },
    {
      "//": "先月のダメージ TOP5（全学年・確定済み）: prevMonthlyDamage の高い順に取得する",
      "collectionGroup": "users",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "prevMonthString", "order": "ASCENDING" },
        { "fieldPath": "prevMonthlyDamage", "order": "DESCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
