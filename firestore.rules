rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ユーザーデータ：認証済みユーザーなら他ユーザーのプロフィール・ランキング情報も読める。書き込みは本人のみ。
    // クライアントが直接 XP/PT/SP 等を書き込む構成のため、ルール側で
    //   (1) 書き込めるフィールドの許可リスト
    //   (2) 1回の書き込みで増やせる量の上限
    // を検証し、devtools からの無制限な数値改ざんを防ぐ。
    // 注意: これは緩和策であり完全な不正防止ではない（真の対策はサーバー側計算＝Cloud Functions化）。
    //
    // 【重要・このルールを編集する人へ】
    // Firestoreのルールは「1リクエストあたり最大1000式」までしか評価できない。
    // 以前このバリデーションを細かくしすぎた結果、所持数の多いアカウントで上限を超え、
    //   "Unable to evaluate the expression as the maximum of 1000 expressions has been reached"
    // となって書き込みが丸ごと拒否され、実績の受け取りが失敗する不具合が発生した。
    // （merge:true の更新では request.resource.data がドキュメント全体になるため、
    //   毎回すべてのフィールドが検証され、式数が積み上がる点に注意）
    // そのため、ここでは意図的にチェックを絞っている：
    //   - 効果の薄い各文字列フィールドの長さチェックは行わない
    //   - 絶対上限(ceiling)は設けない。1回あたりの増加量(delta)だけで十分に抑止できるうえ、
    //     絶対上限は過去に「上限に達したアカウントが二度と書き込めない」ロックアウトも招いた
    // チェックを追加する場合は必ず scripts/simulateClaim 相当の検証で式数に余裕があるか確認すること。
    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && isValidUserDoc(request.resource.data, null);

      allow update: if request.auth != null
        && request.auth.uid == userId
        && isValidUserDoc(request.resource.data, resource.data);

      allow delete: if false;
    }

    // 保護者・先生向け共有コード：コード文字列 → uid のマッピング。
    // 本人（uid本人）だけが自分のuid宛てに新規作成できる。一度発行したコードは上書き・削除不可（衝突時はクライアント側で別コードを再生成）。
    // 保護者は匿名認証でサインインしてから読み取る想定（request.auth はログイン不要でも匿名認証で満たせる）。
    match /shareCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/shareCodes/$(code));
      allow update, delete: if false;
    }

    // グローバル統計（レイドボス等）：誰でも読み取り可能、ログイン済みユーザーなら書き込み可能。
    // 全プレイヤー共有のドキュメントなので、level/hp の型・範囲を検証し、
    // 荒らし目的での異常値書き込み（例: hp を負の巨大値にする等）を防ぐ。
    match /globalStats/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isValidGlobalStats(request.resource.data);
    }

    function numOr0(data, key) {
      return (key in data) && (data[key] is number) ? data[key] : 0;
    }

    // 1回の書き込みで増やせる量だけを制限する（絶対上限は設けない。上のコメント参照）。
    // updateDelta: 通常更新1回あたりの最大増加量
    // createAllowance: アカウント作成時（ゲストからの引き継ぎ含む）に許容する初期値
    function withinDelta(newData, oldData, key, updateDelta, createAllowance) {
      let oldVal = oldData == null ? 0 : numOr0(oldData, key);
      let maxIncrease = oldData == null ? createAllowance : updateDelta;
      return !(key in newData) || (
        newData[key] is number
        && newData[key] >= 0
        && newData[key] <= oldVal + maxIncrease
      );
    }

    // 週間XP・月間ダメージ用。期間が変わったとき（lastWeekString / lastMonthString が変化）は
    // 0にリセットされるため、増加上限のチェックを免除する。
    function withinPeriodDelta(newData, oldData, key, periodKey, maxDelta) {
      return !(key in newData) || (
        newData[key] is number
        && newData[key] >= 0
        && (
          oldData == null
          || newData[key] <= numOr0(oldData, key) + maxDelta
          || !(periodKey in oldData)
          || newData[periodKey] != oldData[periodKey]
        )
      );
    }

    function isValidUserDoc(newData, oldData) {
      return newData.keys().hasOnly([
        'id', 'name', 'xp', 'pt', 'sp', 'effects', 'grade',
        'mistakeIds', 'masteredIds', 'titles', 'equippedTitle',
        'avatars', 'equippedAvatar', 'equipments', 'equippedEquipment',
        'theme', 'totalDamage', 'equippedEffect', 'weeklyXp', 'lastWeekString',
        'monthlyDamage', 'lastMonthString', 'scaryMode', 'claimedAchievements',
        'lastLoginDate', 'loginStreak', 'categorySolved',
        'mistakeStages', 'mistakeNextReview', 'shareCode',
        'bestWeeklyHeroRank', 'bestDamageRank'
      ])

      // ランキングに他の子から見える名前と、ランキングの学年分けに使う値だけは検証する。
      && (!('name' in newData) || (newData.name is string && newData.name.size() <= 30))
      && (!('grade' in newData) || (newData.grade is int && newData.grade >= 1 && newData.grade <= 6))

      // ドキュメントの肥大化（＝コスト増・読み込み遅延）を防ぐための上限。
      && (!('mistakeIds' in newData) || newData.mistakeIds.size() <= 2000)
      && (!('masteredIds' in newData) || newData.masteredIds.size() <= 5000)
      && (!('titles' in newData) || newData.titles.size() <= 500)
      && (!('avatars' in newData) || newData.avatars.size() <= 500)
      && (!('effects' in newData) || newData.effects.size() <= 500)
      && (!('equipments' in newData) || newData.equipments.size() <= 500)
      && (!('claimedAchievements' in newData) || newData.claimedAchievements.size() <= 500)
      && (!('mistakeStages' in newData) || newData.mistakeStages.size() <= 2000)
      && (!('mistakeNextReview' in newData) || newData.mistakeNextReview.size() <= 2000)

      // 連続ログインは1日1増加まで。
      && (!('loginStreak' in newData) || (
        newData.loginStreak is int
        && newData.loginStreak >= 1
        && (oldData == null || newData.loginStreak <= numOr0(oldData, 'loginStreak') + 1)
      ))

      // ランキング実績用の自己最高順位。記録が縮まる方向にしか更新できない。
      && (!('bestWeeklyHeroRank' in newData) || (
        newData.bestWeeklyHeroRank is int
        && newData.bestWeeklyHeroRank >= 1
        && (oldData == null || numOr0(oldData, 'bestWeeklyHeroRank') == 0
            || newData.bestWeeklyHeroRank <= numOr0(oldData, 'bestWeeklyHeroRank'))
      ))
      && (!('bestDamageRank' in newData) || (
        newData.bestDamageRank is int
        && newData.bestDamageRank >= 1
        && (oldData == null || numOr0(oldData, 'bestDamageRank') == 0
            || newData.bestDamageRank <= numOr0(oldData, 'bestDamageRank'))
      ))

      // xp / totalDamage: 通常プレイ由来のみ（1セッション最大 約3,600 相当）→ 更新は5,000まで。
      && withinDelta(newData, oldData, 'xp', 5000, 1000000)
      && withinDelta(newData, oldData, 'totalDamage', 5000, 1000000)
      // pt / sp: 「実績まとめ受け取り」で一度に大きく増える（全実績合計 最大 約54.3万PT / 約20.1万SP）。
      && withinDelta(newData, oldData, 'pt', 600000, 600000)
      && withinDelta(newData, oldData, 'sp', 250000, 250000)
      && withinPeriodDelta(newData, oldData, 'weeklyXp', 'lastWeekString', 5000)
      && withinPeriodDelta(newData, oldData, 'monthlyDamage', 'lastMonthString', 5000);
    }

    function isValidGlobalStats(newData) {
      return newData.keys().hasOnly(['level', 'hp', 'month'])
        && (!('level' in newData) || (newData.level is int && newData.level >= 1 && newData.level <= 10))
        && (!('hp' in newData) || (newData.hp is number && newData.hp >= 0 && newData.hp <= 300000))
        && (!('month' in newData) || (newData.month is string && newData.month.size() <= 10));
    }
  }
}
