rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ユーザーデータ：認証済みユーザーなら他ユーザーのプロフィール・ランキング情報も読める。書き込みは本人のみ。
    // クライアントが直接 XP/PT/SP 等を書き込む構成のため、値の型・範囲・1回の書き込みあたりの増加量を
    // ルールで制限し、devtools からの無制限な数値改ざんを防ぐ。
    // 注意: これは緩和策であり完全な不正防止ではない（真の対策はサーバー側計算＝Cloud Functions化）。
    // 実績の「まとめて受け取り」機能が PT/SP を1回の書き込みで大きく増やすため、
    // その正規の最大合計値を考慮した上限（下記コメント参照）を設定している。
    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && isValidUserDoc(request.resource.data, null);

      allow update: if request.auth != null
        && request.auth.uid == userId
        && isValidUserDoc(request.resource.data, resource.data);

      allow delete: if false;
    }

    // 保護者・先生向け共有コード：コード文字列 → uid のマッピング。
    // 本人（uid本人）だけが自分のuid宛てに新規作成できる。一度発行したコードは上書き・削除不可（衝突時はクライアント側で別コードを再生成）。
    // 保護者は匿名認証でサインインしてから読み取る想定（request.auth はログイン不要でも匿名認証で満たせる）。
    match /shareCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/shareCodes/$(code));
      allow update, delete: if false;
    }

    // グローバル統計（レイドボス等）：誰でも読み取り可能、ログイン済みユーザーなら書き込み可能。
    // 全プレイヤー共有のドキュメントなので、level/hp の型・範囲を検証し、
    // 荒らし目的での異常値書き込み（例: hp を負の巨大値にする等）を防ぐ。
    match /globalStats/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isValidGlobalStats(request.resource.data);
    }

    function numOr0(data, key) {
      return (key in data) && (data[key] is number) ? data[key] : 0;
    }

    // key: フィールド名 / updateDelta: 通常更新1回あたりの最大増加量
    // createAllowance: アカウント作成時（ゲスト引き継ぎ含む）に許容する初期値の上限
    // ceiling: このフィールドが取りうる絶対上限値
    //
    // effectiveCeiling: 過去（旧デバッグパネル等）に ceiling を超える値が書き込まれてしまった
    // アカウントが、以後ずっと一切の更新を拒否され続ける（実質アカウント破損）のを防ぐため、
    // 既存値が ceiling を超えている場合はその既存値を基準にする。
    // 【修正】以前は effectiveCeiling を oldVal そのものにしていたため、newData <= effectiveCeiling
    // (= newData <= oldVal) が要求され、汚染されたアカウントがそれ以降ずっと値を1も増やせなく
    // なっていた（「ポイントが多い人ほど新たに獲得できない」バグ）。oldVal + maxIncrease を
    // 上限にすることで、汚染された絶対値はそのまま（手動修正が必要）だが、通常のプレイ・実績
    // 受け取りによる増加は引き続きでき、1回の書き込みで増やせる量も従来どおり制限される。
    function withinDelta(newData, oldData, key, updateDelta, createAllowance, ceiling) {
      let oldVal = oldData == null ? 0 : numOr0(oldData, key);
      let maxIncrease = oldData == null ? createAllowance : updateDelta;
      let effectiveCeiling = oldVal > ceiling ? oldVal + maxIncrease : ceiling;
      return !(key in newData) || (
        newData[key] is number
        && newData[key] >= 0
        && newData[key] <= effectiveCeiling
        && newData[key] <= oldVal + maxIncrease
      );
    }

    function isValidUserDoc(newData, oldData) {
      return newData.keys().hasOnly([
        'id', 'name', 'xp', 'pt', 'sp', 'effects', 'grade',
        'mistakeIds', 'masteredIds', 'titles', 'equippedTitle',
        'avatars', 'equippedAvatar', 'equipments', 'equippedEquipment',
        'theme', 'totalDamage', 'equippedEffect', 'weeklyXp', 'lastWeekString',
        'monthlyDamage', 'lastMonthString', 'scaryMode', 'claimedAchievements',
        'lastLoginDate', 'loginStreak', 'categorySolved',
        'mistakeStages', 'mistakeNextReview', 'shareCode',
        'bestWeeklyHeroRank', 'bestDamageRank'
      ])

      && (!('name' in newData) || (newData.name is string && newData.name.size() <= 30))
      && (!('grade' in newData) || (newData.grade is int && newData.grade >= 1 && newData.grade <= 6))
      && (!('theme' in newData) || (newData.theme is string && newData.theme.size() <= 50))
      && (!('equippedTitle' in newData) || (newData.equippedTitle is string && newData.equippedTitle.size() <= 50))
      && (!('equippedAvatar' in newData) || (newData.equippedAvatar is string && newData.equippedAvatar.size() <= 50))
      && (!('equippedEquipment' in newData) || (newData.equippedEquipment is string && newData.equippedEquipment.size() <= 50))
      && (!('equippedEffect' in newData) || (newData.equippedEffect is string && newData.equippedEffect.size() <= 50))
      && (!('scaryMode' in newData) || newData.scaryMode is bool)
      && (!('lastLoginDate' in newData) || (newData.lastLoginDate is string && newData.lastLoginDate.size() <= 10))
      && (!('lastWeekString' in newData) || (newData.lastWeekString is string && newData.lastWeekString.size() <= 10))
      && (!('lastMonthString' in newData) || (newData.lastMonthString is string && newData.lastMonthString.size() <= 10))

      && (!('effects' in newData) || (newData.effects is list && newData.effects.size() <= 300))
      && (!('titles' in newData) || (newData.titles is list && newData.titles.size() <= 300))
      && (!('avatars' in newData) || (newData.avatars is list && newData.avatars.size() <= 300))
      && (!('equipments' in newData) || (newData.equipments is list && newData.equipments.size() <= 300))
      && (!('mistakeIds' in newData) || (newData.mistakeIds is list && newData.mistakeIds.size() <= 2000))
      && (!('masteredIds' in newData) || (newData.masteredIds is list && newData.masteredIds.size() <= 5000))
      && (!('claimedAchievements' in newData) || (newData.claimedAchievements is list && newData.claimedAchievements.size() <= 300))
      && (!('mistakeStages' in newData) || (newData.mistakeStages is map && newData.mistakeStages.size() <= 2000))
      && (!('mistakeNextReview' in newData) || (newData.mistakeNextReview is map && newData.mistakeNextReview.size() <= 2000))
      && (!('shareCode' in newData) || (newData.shareCode is string && newData.shareCode.size() <= 12))

      // ランキング実績用の自己最高順位。「更新されるのは記録が縮まる時だけ」にすることで
      // 巻き戻し（悪い順位で上書きして後から良い順位に戻す等の不正操作）の余地を減らす。
      && (!('bestWeeklyHeroRank' in newData) || (
        newData.bestWeeklyHeroRank is int && newData.bestWeeklyHeroRank >= 1 && newData.bestWeeklyHeroRank <= 999
        && (oldData == null || numOr0(oldData, 'bestWeeklyHeroRank') == 0 || newData.bestWeeklyHeroRank <= numOr0(oldData, 'bestWeeklyHeroRank'))
      ))
      && (!('bestDamageRank' in newData) || (
        newData.bestDamageRank is int && newData.bestDamageRank >= 1 && newData.bestDamageRank <= 999
        && (oldData == null || numOr0(oldData, 'bestDamageRank') == 0 || newData.bestDamageRank <= numOr0(oldData, 'bestDamageRank'))
      ))

      && (!('loginStreak' in newData) || (
        newData.loginStreak is int && newData.loginStreak >= 1 && newData.loginStreak <= 5000
        && (oldData == null || newData.loginStreak <= numOr0(oldData, 'loginStreak') + 1)
      ))

      // xp / totalDamage: 通常プレイ由来のみ（1セッション最大 約3,600 相当）→ 更新は5,000まで。
      // 作成時はゲストで蓄積した分の引き継ぎを考慮し余裕を持たせる。上限はLv300到達に必要な量(約93万)の倍以上。
      && withinDelta(newData, oldData, 'xp', 5000, 1000000, 2000000)
      && withinDelta(newData, oldData, 'totalDamage', 5000, 1000000, 2000000)
      // pt / sp: 通常プレイに加え「実績まとめ受け取り」で一度に増える。
      // 全実績（ランキング実績追加後）の合計は最大 約54.3万PT / 約20.1万SP のため、
      // それを1回の書き込みで受け取っても弾かれないよう更新上限に余裕を持たせている。
      // 絶対上限（ceiling）も、長期間・複数年にわたる累計プレイで正規に到達しうる範囲を
      // 想定し、以前の設定（100万/50万）から引き上げた。
      && withinDelta(newData, oldData, 'pt', 600000, 600000, 5000000)
      && withinDelta(newData, oldData, 'sp', 250000, 250000, 2000000)
      // 週間/月間カウンターは期間が変わるとリセットされるため増加上限チェックを免除する
      && (!('weeklyXp' in newData) || (
        newData.weeklyXp is number && newData.weeklyXp >= 0 && newData.weeklyXp <= 1000000
        && (oldData == null
            || newData.weeklyXp <= numOr0(oldData, 'weeklyXp') + 5000
            || newData.lastWeekString != (oldData.lastWeekString is string ? oldData.lastWeekString : ''))
      ))
      && (!('monthlyDamage' in newData) || (
        newData.monthlyDamage is number && newData.monthlyDamage >= 0 && newData.monthlyDamage <= 1000000
        && (oldData == null
            || newData.monthlyDamage <= numOr0(oldData, 'monthlyDamage') + 5000
            || newData.lastMonthString != (oldData.lastMonthString is string ? oldData.lastMonthString : ''))
      ));
    }

    function isValidGlobalStats(newData) {
      return newData.keys().hasOnly(['level', 'hp', 'month'])
        && (!('level' in newData) || (newData.level is int && newData.level >= 1 && newData.level <= 10))
        && (!('hp' in newData) || (newData.hp is number && newData.hp >= 0 && newData.hp <= 300000))
        && (!('month' in newData) || (newData.month is string && newData.month.size() <= 10));
    }
  }
}
